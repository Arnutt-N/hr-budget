parameters:
    level: 3
    paths:
        - src
    # Scan public/index.php first so the BASE_PATH / BASE_URL constants it
    # defines are known to phpstan when analysing src/ files that reference them.
    scanFiles:
        - public/index.php
    # src/Core/Http was previously excluded wholesale; it is now analysed like
    # the rest of src/ (new errors gate pushes instead of hiding).

includes:
    - phpstan-baseline.neon